# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Build uWSGI and any wheels that need compilation. sqlite3 CLI for inspecting instance/database.db.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpcre3 \
        libpcre3-dev \
        sqlite3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash appuser

WORKDIR /home/appuser/app
COPY --chown=appuser:appuser ./ ./

# WORKDIR created this path as root; ensure appuser owns the tree and data dirs exist.
RUN mkdir -p /home/appuser/app/files /home/appuser/app/instance \
    && chown -R appuser:appuser /home/appuser/app

USER appuser

ENV PATH="/home/appuser/.local/bin:${PATH}"

RUN pip install --user --no-cache-dir --upgrade pip \
    && pip install --user --no-cache-dir -r ./requirements.txt

EXPOSE 5000

CMD ["bash", "init_script.sh"]
